# LAMMPS Input File: Manual Graphene Setup with POD + Coulomb
units           metal
atom_style      full
atom_modify     map yes
boundary        p p p
newton          on

# 1. Define Lattice and Box
# Graphene lattice constant a ~ 2.46 Angstroms
# Basis atoms at (0,0,0) and (1/3, 2/3, 0)
lattice         custom 2.46  &
                a1 1.0 0.0 0.0  &
                a2 0.5 0.866025 0.0  &
                a3 0.0 0.0 3.35 &
                basis 0.0 0.0 0.0  &
                basis 0.333333 0.666667 0.0

# Create a region and a box with 1 atom type
region          sim_box block 0 5 0 5 0 1
create_box      1 sim_box
create_atoms    1 region sim_box

# 2. Settings
mass            1 12.011
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

# 3. Manually Assign Alternating Charges (+0.01 and -0.01)
# We use a loop or atom-style variables to alternate based on atom ID
variable        q_val atom "(-1)^id * 0.01"
set             atom * charge v_q_val

# 4. Potential Setup (Hybrid/Overlay)
# Note: Ensure param.pod and coeff.pod are in your working directory
pair_style      hybrid/overlay pod coul/long 10.0

# coefficients for POD (Type 1 is Carbon)
pair_coeff      * * pod param.pod coeff.pod C

# coefficients for Coulomb
pair_coeff      * * coul/long

# 5. KSpace for long-range electrostatics
kspace_style    pppm 1.0e-5
# Slab correction if you want to isolate the sheet in the Z-direction
# kspace_modify   slab 3.0

# 6. Data Extraction and Run
compute         coul_pe all pair coul/long
compute         pod_pe all pair pod

thermo_style    custom step temp pe c_pod_pe c_coul_pe
thermo          1
run             0
